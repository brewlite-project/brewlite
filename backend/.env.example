# Keep your existing local database URL when adding JWT configuration.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5433/brewlite_db?schema=public"
PORT=3001
# Generate a random value locally; never commit the populated .env file.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Internal order advance API only. Generate a separate random secret; never expose it to frontend.
INTERNAL_SECRET=
# Background expiration: every minute; unpaid Order TTL remains 15 minutes.
ORDER_EXPIRATION_ENABLED=true
# Rows fetched per batch (1..1000); each Order has its own transaction.
ORDER_EXPIRATION_BATCH_SIZE=50
# Optional: separate migrated PostgreSQL database used by npm run test:integration.
AUTH_TEST_DATABASE_URL=
ORDERS_TEST_DATABASE_URL=

# VNPay Sandbox - Phase 2
# Use backend/.env for real credentials. Never commit actual secrets.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
# Required only by the internal QueryDR client. Scheduler policy remains outside SCRUM-81.
VNPAY_QUERYDR_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_QUERYDR_TIMEOUT_MS=
