# Keep your existing local database URL when adding JWT configuration.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5433/brewlite_db?schema=public"
PORT=3001
# Generate a random value locally; never commit the populated .env file.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Internal order advance API only. Generate a separate random secret; never expose it to frontend.
INTERNAL_SECRET=
# Background expiration: every minute; unpaid Order TTL remains 15 minutes.
ORDER_EXPIRATION_ENABLED=true
# Rows fetched per batch (1..1000); each Order has its own transaction.
ORDER_EXPIRATION_BATCH_SIZE=50
# Optional: separate migrated PostgreSQL database used by npm run test:integration.
AUTH_TEST_DATABASE_URL=
ORDERS_TEST_DATABASE_URL=

# VNPay Sandbox - Phase 2
# Use backend/.env for real credentials. Never commit actual secrets.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
# Required only by the internal QueryDR client. Scheduler policy remains outside SCRUM-81.
VNPAY_QUERYDR_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_QUERYDR_TIMEOUT_MS=

# SCRUM-82 / P2-08 - internal Payment Reconciliation Scheduler.
# Production MUST set true and have valid QueryDR credentials/IP/lease or startup fails.
# Non-production defaults to disabled if unset; set false explicitly only in tests/dev.
# If the deployment is not ready for reconciliation, do not start it as production.
PAYMENT_RECONCILIATION_ENABLED=false
# Database due scan; one tick every 60s, max 50 candidates per batch.
PAYMENT_RECONCILIATION_INTERVAL_MS=60000
PAYMENT_RECONCILIATION_BATCH_SIZE=50
# Technical defaults, NOT a merchant-approved timeout/lease policy.
# Lease must exceed VNPAY_QUERYDR_TIMEOUT_MS by at least 13000ms.
PAYMENT_RECONCILIATION_LEASE_MS=60000
# BR-05: >=10min between attempts; configurable upward for merchant rate limit.
PAYMENT_RECONCILIATION_COOLDOWN_MS=600000
# Required only when enabled: public/server source IP used in QueryDR payload.
PAYMENT_RECONCILIATION_IP_ADDR=
