# Copy this file to compose.env. compose.env is local-only and ignored by Git.
# Docker Compose interpolation reads this file only when you pass
# `--env-file compose.env`; it is not automatically injected into containers.

# PostgreSQL initialization values for the isolated Compose database. These
# values must match the username, password, and database encoded in DATABASE_URL.
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=replace-with-a-local-random-password
POSTGRES_DB=brewlite_compose
# Optional host loopback port for PostgreSQL (defaults to 15432, outside the
# Windows Hyper-V/WinNAT dynamic ephemeral port range 49152-65535).
POSTGRES_HOST_PORT=15432

# Used only by migrate and backend. The hostname MUST be postgres and port MUST
# be 5432, never localhost or the host-published port. URL-encode the password
# portion if it contains reserved URL characters.
DATABASE_URL=postgresql://brewlite:replace-with-url-encoded-password@postgres:5432/brewlite_compose?schema=public

# Required by the backend. Use independent local random values; JWT_SECRET needs
# at least 32 bytes. Do not use these placeholder strings as real secrets.
JWT_SECRET=replace-with-a-local-random-secret-at-least-32-bytes
INTERNAL_SECRET=replace-with-a-separate-local-random-secret

# Optional backend settings; these defaults match the application defaults.
ORDER_EXPIRATION_ENABLED=true
ORDER_EXPIRATION_BATCH_SIZE=50

# Required VNPay sandbox configuration for the Compose backend.
# The backend runs with payment reconciliation enabled, so valid VNPay
# QueryDR configuration is required for the backend container to start.
# Keep real secrets only in compose.env; never commit compose.env.
VNPAY_TMN_CODE=replace-with-vnpay-sandbox-tmn-code
VNPAY_HASH_SECRET=replace-with-vnpay-sandbox-hash-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment
VNPAY_ALLOW_HTTP_LOCAL_RETURN_URL=true
VNPAY_QUERYDR_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_QUERYDR_TIMEOUT_MS=10000

# Payment reconciliation scheduler
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_INTERVAL_MS=60000
PAYMENT_RECONCILIATION_BATCH_SIZE=50
PAYMENT_RECONCILIATION_LEASE_MS=60000
PAYMENT_RECONCILIATION_COOLDOWN_MS=600000
PAYMENT_RECONCILIATION_IP_ADDR=127.0.0.1
